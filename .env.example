# ==============================================================================
# Tic-Tac-Toe MVP2 — Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env or set environment variables in your deployment environment.
# Never commit active credentials or secrets to version control.

# Server Port (Default: 8080)
PORT=8080

# Database Configuration
# In-memory H2 (default for local development & testing):
# SPRING_DATASOURCE_URL=jdbc:h2:mem:tictactoedb;DB_CLOSE_DELAY=-1;DB_CLOSE_ON_EXIT=FALSE;MODE=PostgreSQL
# SPRING_DATASOURCE_DRIVER=org.h2.Driver
# SPRING_DATASOURCE_USERNAME=sa
# SPRING_DATASOURCE_PASSWORD=

# External PostgreSQL (for production deployments like Render/Heroku/Docker):
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/tictactoe
SPRING_DATASOURCE_DRIVER=org.postgresql.Driver
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_secure_password_here

# JPA & Hibernate Configuration
# Options: 'update' (development), 'validate' (production)
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=false

# CORS & Allowed Origins (Optional override if using custom frontend host)
# ALLOWED_ORIGINS=https://your-frontend-domain.com
